# Spring
SPRING_PROFILE=dev

# Database
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis (host/port only needed when running app outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Spring Session: 24-hour inactivity timeout, indexed Redis sessions
SPRING_SESSION_TIMEOUT=24h
SPRING_SESSION_DATA_REDIS_NAMESPACE=scheduler:sessions
# SESSION is HttpOnly, Path=/, host-only, SameSite=Lax.
# prod profile enables Secure; leave automatic HTTPS detection in development.
# Do not override Secure to false in production.
# Frontend/API must be same-site (localhost ports or HTTPS subdomains of the same site).

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP / SMS: production requires a positive operator-defined global daily issuance cap.
# Zero disables the cap only outside prod. OTP timing/request limits follow the fixed API contract.
OTP_GLOBAL_DAILY_SMS_CAP=0

# Reverse proxy: regex of proxy IPs whose X-Forwarded-For is trusted (empty = trust none)
# Example for a proxy on a Docker network: 172\.18\.\d{1,3}\.\d{1,3}
TRUSTED_PROXIES=

