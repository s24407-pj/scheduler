# Local development: copy to .env and use docker-compose.dev.yml.
# The base Compose file defaults to prod; do not use this file for deployment.

# Required while interpolating the base Compose, before the dev override is merged.
# Production must use the GHCR digest from a successful release run.
SCHEDULER_IMAGE=scheduler:dev

# Local development only; replace these before any non-local deployment.
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis (host/port only needed when running app outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Spring Session: 24-hour inactivity timeout, indexed Redis sessions
SPRING_SESSION_TIMEOUT=24h
SPRING_SESSION_DATA_REDIS_NAMESPACE=scheduler:sessions
# SESSION is HttpOnly, Path=/, host-only, SameSite=Lax.
# prod profile enables Secure; leave automatic HTTPS detection in development.
# Do not override Secure to false in production.
# Frontend/API must be same-site (localhost ports or HTTPS subdomains of the same site).

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP / SMS: production requires a positive operator-defined global daily issuance cap.
# Zero disables the cap only outside prod. OTP timing/request limits follow the fixed API contract.
OTP_GLOBAL_DAILY_SMS_CAP=0
# Required only with SPRING_PROFILE=prod; sender must be enabled on the JustSend account.
JUSTSEND_APP_KEY=
JUSTSEND_SENDER=
# Independent provider concurrency limits (1-16); backlog stays in PostgreSQL.
SMS_WORKER_OTP_CONCURRENCY=2
SMS_WORKER_NOTIFICATION_CONCURRENCY=4

# Reverse proxy: regex of proxy IPs whose X-Forwarded-For is trusted (empty = trust none)
# Match only the actual trusted proxy peer IP(s); see docs/deployment.md.
TRUSTED_PROXIES=
SERVER_TOMCAT_REMOTEIP_REMOTE_IP_HEADER=X-Forwarded-For

# Local placeholder values so Compose can start; replace with a real R2 bucket to upload images.
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY=local-placeholder
R2_SECRET_KEY=local-placeholder
R2_BUCKET_NAME=scheduler
R2_PUBLIC_URL=https://images.example.invalid

