# Spring
SPRING_PROFILE=dev

# Database
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis (host/port only needed when running app outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (the default below is accepted only with the dev or test profile; generate one with: openssl rand -base64 48)
JWT_SECRET=ToJestTymczasowySekretDoRozwojuAplikacjiLokalnieWymienGoNaProdukcji
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP / SMS
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_WINDOW_MINUTES=5
OTP_VERIFICATION_MAX_ATTEMPTS=3
OTP_VERIFICATION_IP_MAX_ATTEMPTS=10
OTP_VERIFICATION_IP_RATE_WINDOW_MINUTES=5
OTP_REQUEST_IP_MAX_ATTEMPTS=10
OTP_REQUEST_IP_RATE_WINDOW_MINUTES=15

# Reverse proxy: regex of proxy IPs whose X-Forwarded-For is trusted (empty = trust none)
# Example for a proxy on a Docker network: 172\.18\.\d{1,3}\.\d{1,3}
TRUSTED_PROXIES=

